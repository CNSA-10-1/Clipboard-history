<Window x:Class="ClipboardHistory.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="420" Height="520"
        ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Ui}"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource Brush.WindowBg}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,4,20,16">

                <!-- ══ 保留期限 ══ -->
                <TextBlock Style="{StaticResource Style.SectionTitle}" Text="保留期限" Margin="0,4,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="RetentionBox"
                             Style="{StaticResource Style.NumberBox}"
                             PreviewTextInput="DigitsOnly_PreviewTextInput"
                             DataObject.Pasting="NumberBox_Pasting" />
                    <TextBlock Text="天"
                               FontSize="13"
                               Margin="8,0,16,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <Button Style="{StaticResource Style.SmallPill}" Content="1 天" Click="PresetDays_Click" Tag="1" />
                    <Button Style="{StaticResource Style.SmallPill}" Content="3 天" Click="PresetDays_Click" Tag="3" />
                    <Button Style="{StaticResource Style.SmallPill}" Content="5 天" Click="PresetDays_Click" Tag="5" />
                    <Button Style="{StaticResource Style.SmallPill}" Content="7 天" Click="PresetDays_Click" Tag="7" />
                    <Button Style="{StaticResource Style.SmallPill}" Content="30 天" Click="PresetDays_Click" Tag="30" />
                </StackPanel>
                <TextBlock Style="{StaticResource Style.Hint}" Text="置顶的内容不受这个限制，会一直保留。" />

                <!-- ══ 最大存储容量 ══ -->
                <TextBlock Style="{StaticResource Style.SectionTitle}" Text="最大存储容量" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="CapacityBox"
                             Style="{StaticResource Style.NumberBox}"
                             PreviewTextInput="DigitsOnly_PreviewTextInput"
                             DataObject.Pasting="NumberBox_Pasting" />
                    <TextBlock Text="MB"
                               FontSize="13"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Style.Hint}"
                           Text="超出后从最旧的、且没被置顶的内容开始删。图片比较占地方，别设太小。" />

                <!-- ══ 开机自动启动 ══ -->
                <TextBlock Style="{StaticResource Style.SectionTitle}" Text="开机自动启动" />
                <ToggleButton x:Name="AutoStartSwitch"
                              Style="{StaticResource Style.Switch}"
                              HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Style.Hint}" Text="开机后在托盘里待着，不会弹出窗口。" />

                <!-- ══ 主题 ══ -->
                <TextBlock Style="{StaticResource Style.SectionTitle}" Text="主题" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeLight" Style="{StaticResource Style.FilterPill}"
                                 Content="浅色" Tag="Light" />
                    <RadioButton x:Name="ThemeDark" Style="{StaticResource Style.FilterPill}"
                                 Content="深色" Tag="Dark" />
                    <RadioButton x:Name="ThemeSystem" Style="{StaticResource Style.FilterPill}"
                                 Content="跟随系统" Tag="System" />
                </StackPanel>

                <!-- ══ 数据 ══ -->
                <Border Height="1"
                        Margin="0,18,0,14"
                        Background="{DynamicResource Brush.Separator}" />

                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Style.Button}"
                            Content="打开数据文件夹"
                            Click="OpenDataFolder_Click" />
                    <Button Style="{StaticResource Style.Button.Danger}"
                            Margin="10,0,0,0"
                            Content="清空所有历史"
                            Click="ClearHistory_Click" />
                </StackPanel>
                <TextBlock Style="{StaticResource Style.Hint}"
                           Text="所有内容只存在你自己的电脑上，不会上传。" />

                <!-- ══ 关于 ══ -->
                <Border Height="1"
                        Margin="0,18,0,14"
                        Background="{DynamicResource Brush.Separator}" />

                <TextBlock Style="{StaticResource Style.SectionTitle}" Text="关于" />

                <!--
                    版本号和**当前在跑的 exe 的完整路径**。
                    路径看着有点技术，但它是"我开的到底是哪一个"这个问题的唯一答案——
                    电脑上同时存在好几个构建输出时（bin\Debug、bin\Release\...\publish…），
                    光看窗口是分不出来的。这个功能就是被这个坑推动加的。
                -->
                <TextBlock x:Name="AboutVersion"
                           FontSize="12"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           Margin="0,4,0,0" />
                <TextBlock x:Name="AboutPath"
                           Style="{StaticResource Style.Hint}" />
            </StackPanel>
        </ScrollViewer>

        <!-- ══ 底部按钮 ══ -->
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource Brush.Separator}"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Style.Button}" Content="取消" Click="Cancel_Click" />
                <Button Style="{StaticResource Style.Button.Primary}"
                        Margin="10,0,0,0"
                        Content="保存"
                        Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
