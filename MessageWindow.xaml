<Window x:Class="ClipboardHistory.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Ui}"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource Brush.WindowBg}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!--
        自己做一个对话框，而不是用系统的 MessageBox。三个原因：
          1. MessageBox 不能控制位置，实测会跑到屏幕外，而它又不可拖拽，用户根本够不着
          2. 它是系统原生窗口，在深色主题下仍然是亮色的，和界面完全脱节
          3. 确认按钮的文案改不了（只能是"是/否"），说清楚"删掉哪些东西"更重要
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText"
                   Grid.Row="0"
                   Margin="20,20,20,4"
                   FontSize="13"
                   LineHeight="20"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.TextPrimary}" />

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20,12,20,16">
            <Button x:Name="CancelButton"
                    Style="{StaticResource Style.Button}"
                    Content="取消"
                    Click="Cancel_Click" />
            <Button x:Name="ConfirmButton"
                    Margin="10,0,0,0"
                    Content="确定"
                    Click="Confirm_Click" />
        </StackPanel>
    </Grid>
</Window>
