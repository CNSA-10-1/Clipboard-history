<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>ClipboardHistory</RootNamespace>
    <AssemblyName>剪贴板历史</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- WPF 是主界面框架；WinForms 只为用 NotifyIcon 做托盘图标（.NET 自带，无需 NuGet） -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- 开启单文件发布时，WPF 需要显式包含原生库 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!--
        只保留中文的框架本地化资源。

        自包含发布默认把 13 种语言的框架资源全打进去（cs/de/es/fr/it/ja/ko/pl/pt-BR/ru/tr/zh-Hans/zh-Hant），
        每种约 1.3 MB，合计 16.9 MB。这些只是**框架内部错误提示的翻译**，
        跟界面文案无关——界面上的字都是我们自己写的，不走这条路。

        不设这个属性的话默认全打包。
    -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <Version>1.0.0</Version>
    <Product>剪贴板历史</Product>
    <AssemblyTitle>剪贴板历史</AssemblyTitle>

    <!-- exe 文件本身的图标（资源管理器、任务栏、Alt+Tab 都用它）。
         图标由 工具\生成图标.ps1 生成，多尺寸的那种 -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    同一个 .ico 也要以 WPF 资源的形式嵌进来，托盘图标才能从里面按尺寸取。
    ApplicationIcon 只是塞进 exe 的 Win32 资源里，WPF 的 GetResourceStream 读不到它。
  -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!--
    关掉 WinForms / Drawing 的全局 using。
    开着 UseWindowsForms 时 SDK 会自动全局引入这两个命名空间，而它们和 WPF 大面积撞名：
      Application、Clipboard、DataObject、Color、Brush、Pen、Point、Size、Font、Timer、Keys…
    只在真正需要托盘图标的 TrayService.cs 里显式 using，并给冲突的类型起别名。
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
