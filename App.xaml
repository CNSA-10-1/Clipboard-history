<Application x:Class="ClipboardHistory.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        没有 StartupUri：主窗口由 App.OnStartup 里手动创建。
        因为启动时要先判单实例——已经有一个在跑了就直接退出，根本不该建窗口。
        ShutdownMode 也必须是 OnExplicitShutdown：
        这是个托盘常驻程序，窗口关掉（其实是隐藏）不该让进程退出，
        只有托盘菜单里的"退出"才真的结束。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 通用样式（不随主题变）。主题配色字典由 ThemeService 启动时插到最前面。 -->
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
