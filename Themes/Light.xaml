<!--
    浅色主题配色。
    色值来源：docs/03-设计规范.md —— 改颜色请先改那份文档，再改这里。

    ⚠️ 本文件的键名必须和 Dark.xaml 完全一致，否则切主题时会缺资源。
    ⚠️ XAML 里引用这些资源一律用 DynamicResource，用 StaticResource 切主题时不会刷新。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景 -->
    <SolidColorBrush x:Key="Brush.WindowBg"    Color="#F2F7FC" />
    <SolidColorBrush x:Key="Brush.CardBg"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardHover"   Color="#EAF3FC" />
    <SolidColorBrush x:Key="Brush.InputBg"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Separator"   Color="#E8EEF5" />

    <!-- 边框 -->
    <SolidColorBrush x:Key="Brush.CardBorder"  Color="#E1E8F0" />

    <!-- 主色（淡蓝） -->
    <SolidColorBrush x:Key="Brush.Accent"      Color="#4A9BE8" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#3A8AD8" />
    <SolidColorBrush x:Key="Brush.AccentSoft"  Color="#E3F0FC" />

    <!-- 主色块上的前景色 / 开关的圆点。
         单独开两个键是因为它们必须和主色"成对"变：浅色主题主色是深蓝，上面配白字；
         深色主题主色是亮蓝，白字就糊了，得配深色字。 -->
    <SolidColorBrush x:Key="Brush.OnAccent"   Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SwitchKnob" Color="#FFFFFF" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="Brush.TextPrimary"   Color="#1F2937" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#6B7280" />
    <SolidColorBrush x:Key="Brush.TextDisabled"  Color="#A8B0BA" />

    <!-- 图标按钮 -->
    <SolidColorBrush x:Key="Brush.IconIdle"    Color="#B8C4D0" />
    <SolidColorBrush x:Key="Brush.IconHover"   Color="#4A9BE8" />
    <SolidColorBrush x:Key="Brush.Danger"      Color="#E04545" />

    <!-- 危险操作的悬停底色。带透明度是为了让它自然叠在卡片背景上，
         深浅主题各自配一份，而不是在样式里写死 -->
    <SolidColorBrush x:Key="Brush.DangerSoft"  Color="#22E04545" />

</ResourceDictionary>
