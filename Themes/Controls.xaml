<!--
    通用控件样式。
    与 Light.xaml / Dark.xaml 不同，这份**不随主题切换**，所以不放进 MergedDictionaries 的替换流程里。

    ⚠️ 颜色一律用 DynamicResource 引用主题键，绝不在本文件里写死色值——
       否则切到深色主题时那一处不会跟着变（docs/06-测试验收.md 里有这条检查）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:ClipboardHistory.Ui">

    <!-- ── 字体 ── -->
    <FontFamily x:Key="Font.Ui">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe MDL2 Assets</FontFamily>

    <!-- ── 尺寸 ── -->

    <!-- ══════════════════════════════════════════════
         卡片
         ══════════════════════════════════════════════ -->

    <!-- 卡片外框 -->
    <Style x:Key="Style.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.CardHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        卡片右上角的操作按钮组。
        平时半透明、不抢视线；鼠标落在卡片上才完全显现。
        这里用 DataTrigger 找最近的 Border 祖先（就是卡片外框）的 IsMouseOver，
        因为 StackPanel 自己的 IsMouseOver 只覆盖按钮那一小块，不是整张卡片。
    -->
    <Style x:Key="Style.CardActions" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Opacity" Value="0.35" />
        <Style.Triggers>
            <!--
                已置顶的卡片，图钉一直亮着。
                否则 0.35 的半透明会把"淡蓝实心"和普通灰色图钉的差别盖掉，
                一眼看不出哪条被置顶了。

                这里刻意不用 Storyboard 做淡入淡出：动画值的优先级高于触发器，
                退出动画会把 Opacity 钉死在 0.35，上述触发器就再也生效不了。
                资源在正确性面前，0.15 秒的过渡可以不要。
            -->
            <DataTrigger Binding="{Binding Pinned}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>

            <!-- 鼠标落在卡片上时整组按钮完全显现 -->
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}"
                         Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 圆形图标按钮：水蓝色悬停底，用于设置齿轮等中性按钮 -->
    <Style x:Key="Style.CircleButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icon}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="2,0,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.IconIdle}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="13" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 置顶按钮：已置顶时图钉点亮成主色 -->
    <Style x:Key="Style.PinButton" TargetType="Button" BasedOn="{StaticResource Style.CircleButton}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Pinned}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 删除按钮：悬停时文字和底色都转红 -->
    <Style x:Key="Style.DeleteButton" TargetType="Button" BasedOn="{StaticResource Style.CircleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="13" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- 用带透明度的红做底色，深浅主题下都不用另配一份 -->
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════════════════════════════════════════
         搜索框
         ══════════════════════════════════════════════ -->

    <Style x:Key="Style.SearchBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="32,0,30,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
        <Setter Property="Background" Value="{DynamicResource Brush.InputBg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════
         类型筛选胶囊
         ══════════════════════════════════════════════ -->

    <!-- 用 RadioButton 而不是 Button：只为保证"同一时刻只能选中一个"是系统行为，不用自己写逻辑 -->
    <Style x:Key="Style.FilterPill" TargetType="RadioButton">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg"
                            CornerRadius="13"
                            Height="26"
                            Padding="12,0"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════
         展开 / 收起
         ══════════════════════════════════════════════ -->

    <Style x:Key="Style.ExpandToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Label"
                                       Text="展开"
                                       FontSize="11"
                                       Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock x:Name="Chevron"
                                       FontFamily="{StaticResource Font.Icon}"
                                       Text="{x:Static ui:Icons.ChevronDown}"
                                       FontSize="9"
                                       Margin="3,2,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="Text" Value="收起" />
                            <Setter TargetName="Chevron" Property="Text" Value="{x:Static ui:Icons.ChevronUp}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════
         路径链接
         ══════════════════════════════════════════════ -->

    <!-- 文件详情里的路径。做成按钮是为了能点、有手型光标，
         但外观要完全像一行普通文字，不能像个按钮 -->
    <Style x:Key="Style.PathLink" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════
         设置窗口用的控件
         ══════════════════════════════════════════════ -->

    <!-- 分组标题 -->
    <Style x:Key="Style.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <!-- 说明小字 -->
    <Style x:Key="Style.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 数字输入框：右对齐（数字右对齐才好比较大小），只接受数字由代码拦 -->
    <Style x:Key="Style.NumberBox" TargetType="TextBox">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardBorder}" />
        <Setter Property="Background" Value="{DynamicResource Brush.InputBg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg"
                            CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 小号胶囊按钮（保留期限的那排快捷天数） -->
    <Style x:Key="Style.SmallPill" TargetType="Button">
        <Setter Property="Height" Value="22" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            CornerRadius="11"
                            Padding="10,0"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Brush.CardBorder}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 开关。44×22 的胶囊，圆点左右滑 -->
    <Style x:Key="Style.Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track"
                                CornerRadius="11"
                                Background="{DynamicResource Brush.CardBorder}" />
                        <Ellipse x:Name="Knob"
                                 Width="16" Height="16"
                                 Margin="3,0,0,0"
                                 HorizontalAlignment="Left"
                                 Fill="{DynamicResource Brush.SwitchKnob}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 普通按钮（取消、打开数据文件夹这类） -->
    <Style x:Key="Style.Button" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            CornerRadius="4"
                            Padding="16,0"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Brush.CardBorder}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.CardHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮（保存）：实心主色 -->
    <Style x:Key="Style.Button.Primary" TargetType="Button" BasedOn="{StaticResource Style.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            CornerRadius="4"
                            Padding="20,0"
                            Background="{DynamicResource Brush.Accent}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.AccentHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 危险按钮（清空所有历史）：红字，悬停时底色带淡红 -->
    <Style x:Key="Style.Button.Danger" TargetType="Button" BasedOn="{StaticResource Style.Button}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg"
                            CornerRadius="4"
                            Padding="16,0"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Brush.CardBorder}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- 带透明度的红：深浅主题下都不用另配一份 -->
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════
         列表
         ══════════════════════════════════════════════ -->

    <!-- 去掉 ListBox 默认的蓝底选中效果，换成卡片外圈的淡蓝描边 -->
    <Style x:Key="Style.ClipItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Ring"
                            CornerRadius="8"
                            Padding="2"
                            BorderThickness="2"
                            BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分组标题（"已置顶" / "最近"） -->
    <Style x:Key="Style.GroupHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Margin" Value="2,12,0,6" />
    </Style>

    <!-- ══════════════════════════════════════════════
         滚动条（WPF 默认的太粗太"老"，收成细条）
         ══════════════════════════════════════════════ -->

    <Style x:Key="Style.ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBg" CornerRadius="3" Background="{DynamicResource Brush.IconIdle}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBg" Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Style.ScrollThumb}" Margin="2,0" />
                            </Track.Thumb>
                            <!-- 隐藏上下箭头，Win10 的现代滚动条没有箭头 -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ── 卡片内部专用的细滚动条 ──

        **3px 宽**——外面列表那条（`Style.ScrollBar`）的可见宽度是 4px。

        卡片里的滚动条只是"下面还有内容"的提示，不是主要操作方式：内容是靠滚轮翻的，
        所以做得比列表那条细一点。

        ⚠️ 两个容易改错的地方：

        1. **宽度写死在 Border 上（`Width` + 居中），不用 Margin 去压。**
           靠 Margin 凑宽度得算半个像素，会糊；而且改一个数字就串味。
           写死宽度 + `HorizontalAlignment=Center`，不管轨道多宽，画出来的永远是正正好这么宽，
           落在整数像素上不发虚。

        2. **ScrollBar 的 Width 仍旧是 8，不能跟着改。**
           那 8px 是**鼠标判定区**，不是可见宽度。真改成一样宽的话，想用鼠标拖就得戳进
           3px 宽的缝里，很难点中。轨道是透明的，留多宽都看不出来。
    -->
    <Style x:Key="Style.ScrollThumbSlim" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- 3px 宽给 1 的圆角正合适；给 3 会圆成两头尖的胶囊 -->
                    <Border x:Name="ThumbBg"
                            Width="3"
                            HorizontalAlignment="Center"
                            CornerRadius="1"
                            Background="{DynamicResource Brush.IconIdle}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBg" Property="Background" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.ScrollBarSlim" TargetType="ScrollBar" BasedOn="{StaticResource Style.ScrollBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Style.ScrollThumbSlim}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                              Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ── 卡片内部那个 ScrollViewer 专用的模板 ──

        **为什么不直接在 ScrollViewer.Resources 里放一条隐式 ScrollBar 样式**（原本是那么写的）：
        实测那样**根本不生效**——卡片里显示的仍是系统默认滚动条（实测 13px 宽、带系统配色的轨道），
        我们那两条样式（8px 和 1px）一条都没吃上。

        所以改用和外面列表一样的办法：**在自己的模板里显式指定 ScrollBar 的 Style**。
        模板里写死的样式不依赖隐式样式查找，一定能生效。

        和 `Style.ScrollViewer` 的区别：那个是给虚拟化列表用的，这个给卡片里的小滚动区用。
        其实模板长得一样，但职责不同、改一个不该影响另一个，所以分开两份。
    -->
    <Style x:Key="Style.CardScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollContentPresenter Grid.Column="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar Grid.Column="1"
                                   x:Name="PART_VerticalScrollBar"
                                   Orientation="Vertical"
                                   Style="{StaticResource Style.ScrollBarSlim}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.ScrollViewer" TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--
                            ⚠️ CanContentScroll 这一句不能少，少了整个虚拟化就没了。

                            ScrollContentPresenter 上的 CanContentScroll 默认是 false，
                            而**没有逻辑滚动就没有虚拟化**——列表会把全部条目都真实创建出来。
                            实测 500 条记录：漏了它冷启动 4.7 秒、占 176MB；
                            加上之后 1.2 秒、110MB。

                            系统的默认 ScrollViewer 模板里是有这句的，自己写模板时很容易漏。
                        -->
                        <ScrollContentPresenter Grid.Column="0"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar Grid.Column="1"
                                   x:Name="PART_VerticalScrollBar"
                                   Orientation="Vertical"
                                   Style="{StaticResource Style.ScrollBar}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
