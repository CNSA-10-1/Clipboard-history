<!--
    深色主题配色。
    色值来源：docs/03-设计规范.md —— 改颜色请先改那份文档，再改这里。

    ⚠️ 本文件的键名必须和 Light.xaml 完全一致，否则切主题时会缺资源。
    ⚠️ 深色不是把浅色反相：主色更亮（深底上太暗的蓝看不清），背景用 #1F1F1F 而非纯黑（纯黑刺眼）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 背景 -->
    <SolidColorBrush x:Key="Brush.WindowBg"    Color="#1F1F1F" />
    <SolidColorBrush x:Key="Brush.CardBg"      Color="#2B2B2B" />
    <SolidColorBrush x:Key="Brush.CardHover"   Color="#333B44" />
    <SolidColorBrush x:Key="Brush.InputBg"     Color="#2B2B2B" />
    <SolidColorBrush x:Key="Brush.Separator"   Color="#3A3A3A" />

    <!-- 边框 -->
    <SolidColorBrush x:Key="Brush.CardBorder"  Color="#3A3A3A" />

    <!-- 主色（淡蓝，深色下提亮） -->
    <SolidColorBrush x:Key="Brush.Accent"      Color="#6AB0F3" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#8AC4F7" />
    <SolidColorBrush x:Key="Brush.AccentSoft"  Color="#25384C" />

    <!-- 深色主题的主色比浅色的亮，白字压上去对比度不够，改成深色字 -->
    <SolidColorBrush x:Key="Brush.OnAccent"   Color="#14232F" />
    <SolidColorBrush x:Key="Brush.SwitchKnob" Color="#E8E8E8" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="Brush.TextPrimary"   Color="#E8E8E8" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9AA0A6" />
    <SolidColorBrush x:Key="Brush.TextDisabled"  Color="#6B7075" />

    <!-- 图标按钮 -->
    <SolidColorBrush x:Key="Brush.IconIdle"    Color="#7A828A" />
    <SolidColorBrush x:Key="Brush.IconHover"   Color="#6AB0F3" />
    <SolidColorBrush x:Key="Brush.Danger"      Color="#FF6B6B" />

    <!-- 深色下的危险悬停底色要更亮一点，否则叠在近黑的卡片上看不见 -->
    <SolidColorBrush x:Key="Brush.DangerSoft"  Color="#33FF6B6B" />

</ResourceDictionary>
